# Supabase Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Optional server-side AI endpoint.
# Keep provider API keys on the server. The app falls back to the built-in local insight engine when omitted.
VITE_SOBIMON_AI_ENDPOINT=https://YOUR_BACKEND.example.com/api/sobimon-ai
